<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_light_bg">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"/>

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_melody"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="旋律"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_left_bg"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_chords"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="和弦"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_middle_bg"/>

            <RadioButton
                android:id="@+id/rb_song"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="曲子"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_right_bg"/>

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="风格"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/sp_style"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

        </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/melody_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="0dp"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="创作旋律"
                    android:textSize="17sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/et_melody_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:hint="名称（可选）"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="长度"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="12dp"/>

                    <Spinner
                        android:id="@+id/sp_melody_length"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:hint="描述（可选）"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:padding="14dp"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btn_generate_melody"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:text="生成旋律"
                    android:textSize="15sp"
                    android:textColor="@color/apple_white"
                    android:background="@drawable/apple_button_primary_bg"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chords_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:elevation="0dp"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="创作和弦"
                    android:textSize="17sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/et_chord_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:hint="名称（可选）"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/rg_chord_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rb_from_melody"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="基于旋律"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text"
                        android:buttonTint="@color/apple_accent"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rb_custom"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="自定义"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text"
                        android:buttonTint="@color/apple_accent"/>

                </RadioGroup>

                <Spinner
                    android:id="@+id/sp_melody_select"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/et_key_signature"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:hint="调性（可选）"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/et_mood"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:hint="情绪（可选）"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/et_chord_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:hint="描述（可选）"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:padding="14dp"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_generate_chords"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/song_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:elevation="0dp"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="生成曲子"
                    android:textSize="17sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="旋律"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="12dp"/>

                    <Spinner
                        android:id="@+id/sp_song_melody"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                    <Button
                        android:id="@+id/btn_preview_melody"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:text="试听"
                        android:textSize="13sp"
                        android:textColor="@color/apple_accent"
                        android:background="@drawable/apple_button_minor_bg"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="和弦"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="12dp"/>

                    <Spinner
                        android:id="@+id/sp_song_chords"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                    <Button
                        android:id="@+id/btn_preview_chords"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:text="试听"
                        android:textSize="13sp"
                        android:textColor="@color/apple_accent"
                        android:background="@drawable/apple_button_minor_bg"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_generate_song"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:text="生成歌曲"
                    android:textSize="15sp"
                    android:textColor="@color/apple_white"
                    android:background="@drawable/apple_button_primary_bg"/>

            </LinearLayout>

            <ListView
                android:id="@+id/lv_result"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/apple_card_bg"
                android:divider="@color/apple_separator"
                android:dividerHeight="1dp"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="8dp"
        android:background="@color/apple_light_bg">

        <com.example.musicai.CursorSeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_playback_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/speed_control_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="速度: 1x"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_speed_05"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:layout_weight="1"
                    android:text="0.5x"
                    android:textSize="12sp"
                    android:textColor="@color/apple_button_text"
                    android:background="@drawable/apple_button_bg"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_speed_075"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:layout_weight="1"
                    android:text="0.75x"
                    android:textSize="12sp"
                    android:textColor="@color/apple_button_text"
                    android:background="@drawable/apple_button_bg"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_speed_1"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:layout_weight="1"
                    android:text="1x"
                    android:textSize="12sp"
                    android:textColor="@color/apple_white"
                    android:background="@drawable/apple_button_primary_bg"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_speed_125"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:layout_weight="1"
                    android:text="1.25x"
                    android:textSize="12sp"
                    android:textColor="@color/apple_button_text"
                    android:background="@drawable/apple_button_bg"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_speed_15"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:layout_weight="1"
                    android:text="1.5x"
                    android:textSize="12sp"
                    android:textColor="@color/apple_button_text"
                    android:background="@drawable/apple_button_bg"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_speed_2"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:minHeight="32dp"
                    android:layout_weight="1"
                    android:text="2x"
                    android:textSize="12sp"
                    android:textColor="@color/apple_button_text"
                    android:background="@drawable/apple_button_bg"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:text="播放"
                android:textSize="16sp"
                android:textColor="@color/apple_white"
                android:background="@drawable/apple_button_primary_bg"
                android:enabled="false"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="16sp"
                android:textColor="@color/apple_button_text"
                android:background="@drawable/apple_button_bg"
                android:enabled="false"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/apple_card_bg"
        android:padding="16dp"
        android:elevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="生成成功"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="时长: - | 段落: -"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_secondary"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_expand_detail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/arrow_down_float"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="展开详情"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/detail_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@color/apple_light_bg"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_detail_expanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_detail_save"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="保存到资源库"
                android:textSize="15sp"
                android:textColor="@color/apple_white"
                android:background="@drawable/apple_button_primary_bg"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_detail_discard"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="丢弃"
                android:textSize="15sp"
                android:textColor="@color/apple_warning"
                android:background="@drawable/apple_button_bg"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

</LinearLayout>
