<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_light_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="0dp"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="快速歌曲生成"
                    android:textSize="20sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择一个风格，AI 将自动创作完整曲子"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text_secondary"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="风格"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_secondary"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/sp_style"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:hint="曲子名称（可选）"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/result_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:visibility="gone"
                android:elevation="0dp"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="生成结果"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_secondary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:fontFamily="monospace"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp"
        android:background="@color/apple_light_bg">

        <com.example.musicai.CursorSeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_playback_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/speed_control_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="速度: 1.0x"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <SeekBar
                android:id="@+id/seekbar_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="10"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.5x"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_tertiary"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.0x"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_tertiary"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_generating_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在生成旋律，预计需要 5-10 秒…"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="50dp"
            android:text="一键生成完整曲子"
            android:textSize="16sp"
            android:textColor="@color/apple_white"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:text="播放"
                android:textSize="16sp"
                android:textColor="@color/apple_white"
                android:background="@drawable/apple_button_primary_bg"
                android:enabled="false"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="16sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:enabled="false"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

</LinearLayout>
