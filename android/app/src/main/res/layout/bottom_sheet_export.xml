<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/apple_card_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tv_export_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导出"
            android:textSize="18sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="关闭"/>

    </LinearLayout>

    <View
        android:id="@+id/export_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择导出格式"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_export_midi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="导出 MIDI 文件"
                android:textSize="16sp"
                android:textColor="@color/apple_white"
                android:background="@drawable/apple_button_primary_bg"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_export_wav"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="导出 WAV 音频"
                android:textSize="16sp"
                android:textColor="@color/apple_white"
                android:background="@drawable/apple_button_primary_bg"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MIDI：通用音乐文件格式，可导入DAW软件\nWAV：混缩后的音频文件，可直接播放"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </View>

    <LinearLayout
        android:id="@+id/export_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在导出..."
            android:textSize="14sp"
            android:textColor="@color/apple_text"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/apple_accent"
            android:progressBackgroundTint="@color/apple_separator"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="取消"
        android:textSize="14sp"
        android:textColor="@color/apple_text_secondary"
        android:background="@drawable/apple_button_minor_bg"
        android:layout_marginTop="8dp"/>

</LinearLayout>
