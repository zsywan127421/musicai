<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="编辑音符"
            android:textSize="20sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="关闭"
            android:tint="@color/apple_text_secondary"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="音符"
        android:textSize="13sp"
        android:textColor="@color/apple_text_secondary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_note_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. C4 | 时值:4"
        android:textSize="16sp"
        android:textColor="@color/apple_text"
        android:fontFamily="monospace"
        android:background="@drawable/apple_edittext_bg"
        android:padding="14dp"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音高"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/sp_pitch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:background="@drawable/spinner_bg"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="八度"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/sp_octave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:background="@drawable/spinner_bg"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="时值"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/sp_duration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:background="@drawable/spinner_bg"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:minHeight="50dp"
        android:text="保存修改"
        android:textSize="16sp"
        android:textColor="@color/apple_white"
        android:background="@drawable/apple_button_primary_bg"/>

</LinearLayout>
