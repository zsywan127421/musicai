<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/apple_card_bg"
        android:layout_margin="16dp">

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_melody"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="生成旋律"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_left_bg"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_chords"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="生成和弦"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_middle_bg"/>

            <RadioButton
                android:id="@+id/rb_song"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="生成曲子"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:gravity="center"
                android:button="@null"
                android:background="@drawable/radio_right_bg"/>

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="风格"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/sp_style"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="0dp">

            <LinearLayout
                android:id="@+id/melody_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="创作旋律"
                    android:textSize="16sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="长度"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/sp_melody_length"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/apple_edittext_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="输入创作描述（可选）：如欢快的夏天、悲伤的离别..."
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_secondary"
                    android:background="@drawable/apple_edittext_bg"
                    android:padding="12dp"
                    android:minHeight="44dp"
                    android:inputType="textMultiLine"/>

                <Button
                    android:id="@+id/btn_generate_melody"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="生成旋律并保存到库"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:background="@drawable/apple_button_primary_bg"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chords_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="创作和弦"
                    android:textSize="16sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/rg_chord_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rb_from_melody"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="基于旋律"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text"
                        android:buttonTint="@color/apple_accent"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rb_custom"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="自定义生成"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text"
                        android:buttonTint="@color/apple_accent"/>

                </RadioGroup>

                <Spinner
                    android:id="@+id/sp_melody_select"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_key_signature"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="调性（可选）：如 C大调、A小调"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_secondary"
                    android:background="@drawable/apple_edittext_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/et_mood"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="情绪（可选）：如欢快、忧伤、激昂"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_secondary"
                    android:background="@drawable/apple_edittext_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/et_chord_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="描述（可选）：如充满希望的进行"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_secondary"
                    android:background="@drawable/apple_edittext_bg"
                    android:padding="12dp"
                    android:minHeight="44dp"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_generate_chords"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="生成和弦并保存到库"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:background="@drawable/apple_button_primary_bg"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/song_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择并生成曲子"
                    android:textSize="16sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="旋律"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/sp_song_melody"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/apple_edittext_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>

                    <Button
                        android:id="@+id/btn_preview_melody"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="试听"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text"
                        android:background="@drawable/apple_button_bg"
                        android:layout_marginStart="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="和弦"
                        android:textSize="14sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/sp_song_chords"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/apple_edittext_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>

                    <Button
                        android:id="@+id/btn_preview_chords"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="试听"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text"
                        android:background="@drawable/apple_button_bg"
                        android:layout_marginStart="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_generate_song"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="生成完整曲子"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:background="@drawable/apple_button_primary_bg"/>

            </LinearLayout>

            <ListView
                android:id="@+id/lv_result"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/apple_card_bg"
                android:divider="@color/apple_mid_gray"
                android:dividerHeight="1dp"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="8dp">

        <ProgressBar
            android:id="@+id/playback_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="0"
            android:max="100"
            android:progressTint="@color/apple_accent"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_playback_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textSize="12sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="播放歌曲"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_primary_bg"
                android:enabled="false"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:enabled="false"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
