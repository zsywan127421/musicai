<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_light_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/apple_light_bg">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_down"
            android:tint="@color/apple_text"
            android:rotation="90"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="项目编辑器"
            android:textSize="17sp"
            android:textColor="@color/apple_text"
            android:gravity="center"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:text="保存"
            android:textSize="15sp"
            android:textColor="@color/apple_accent"
            android:background="@drawable/apple_button_minor_bg"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/apple_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"
                android:outlineProvider="background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="项目设置"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_secondary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/et_project_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:hint="项目名称"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_tertiary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp"
                    android:singleLine="true"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BPM"
                            android:textSize="13sp"
                            android:textColor="@color/apple_text_secondary"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/spinner_bg"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/tv_bpm_value"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="120"
                                android:textSize="15sp"
                                android:textColor="@color/apple_text"
                                android:gravity="center_vertical"/>

                            <SeekBar
                                android:id="@+id/seekbar_bpm"
                                android:layout_width="100dp"
                                android:layout_height="44dp"
                                android:max="240"
                                android:progress="120"
                                android:progressTint="@color/apple_accent"
                                android:thumbTint="@color/apple_accent"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="拍号"
                            android:textSize="13sp"
                            android:textColor="@color/apple_text_secondary"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/sp_time_signature"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:minHeight="44dp"
                            android:background="@drawable/spinner_bg"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="调性"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/sp_key_signature"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="轨道"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_secondary"
                    android:textAllCaps="true"/>

                <TextView
                    android:id="@+id/tv_track_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 条"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_tertiary"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/apple_card_bg"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/apple_text_tertiary"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无轨道"
                    android:textSize="16sp"
                    android:textColor="@color/apple_text"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击下方按钮添加第一条轨道"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text_tertiary"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:background="@color/apple_light_bg">

        <Button
            android:id="@+id/btn_add_track"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:minHeight="50dp"
            android:text="添加轨道"
            android:textSize="16sp"
            android:textColor="@color/apple_white"
            android:background="@drawable/apple_button_primary_bg"/>

    </LinearLayout>

</LinearLayout>
