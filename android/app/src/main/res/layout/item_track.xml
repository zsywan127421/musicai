<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/apple_card_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="0dp"
    android:outlineProvider="background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/et_track_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="轨道名称"
            android:textSize="16sp"
            android:textColor="@color/apple_text"
            android:textColorHint="@color/apple_text_tertiary"
            android:background="@android:color/transparent"
            android:paddingVertical="4dp"
            android:singleLine="true"/>

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:tint="@color/apple_warning"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="乐器"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginEnd="12dp"/>

        <Spinner
            android:id="@+id/sp_instrument"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:background="@drawable/spinner_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_mute"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="MUTE"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/apple_button_minor_bg"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_solo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="SOLO"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/apple_button_minor_bg"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_effects"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="效果器"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/apple_button_minor_bg"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音量"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginEnd="12dp"/>

        <SeekBar
            android:id="@+id/seekbar_volume"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/apple_accent"
            android:thumbTint="@color/apple_accent"/>

        <TextView
            android:id="@+id/tv_volume_value"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textSize="13sp"
            android:textColor="@color/apple_text_tertiary"
            android:gravity="end"/>

    </LinearLayout>

</LinearLayout>
