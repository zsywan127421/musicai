<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/apple_card_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="0dp"
    android:outlineProvider="background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轨道 1"
                android:textSize="16sp"
                android:textColor="@color/apple_text"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_instrument"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Piano"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_mute"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="M"
            android:textSize="12sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_solo"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="S"
            android:textSize="12sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:contentDescription="删除"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/track_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_effects"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="效果器"
            android:textSize="13sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>

</LinearLayout>
