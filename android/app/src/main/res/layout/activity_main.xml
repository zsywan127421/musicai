<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MusicAI"
                android:textSize="28sp"
                android:textColor="@color/apple_text"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 音乐创作助手"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/model_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/apple_card_bg"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_check_circle"/>

            <TextView
                android:id="@+id/tv_model_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="大模型已配置"
                android:textSize="14sp"
                android:textColor="@color/apple_text"/>

            <TextView
                android:id="@+id/tv_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gpt-3.5-turbo"
                android:textSize="12sp"
                android:textColor="@color/apple_text_secondary"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="创作工具"
                android:textSize="12sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="8dp"
                android:gravity="start"/>

            <Button
                android:id="@+id/btn_new_song_generator"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="220dp"
                android:text="高级歌曲生成器"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_primary_bg"
                android:layout_marginBottom="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

            <Button
                android:id="@+id/btn_song_generator"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="220dp"
                android:text="快速歌曲生成"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:layout_marginBottom="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

            <Button
                android:id="@+id/btn_library"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="220dp"
                android:text="我的资源库"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:layout_marginBottom="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="编辑器"
                android:textSize="12sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="8dp"
                android:gravity="start"/>

            <Button
                android:id="@+id/btn_melody_editor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:minWidth="200dp"
                android:text="旋律编辑器"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:layout_marginBottom="6dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <Button
                android:id="@+id/btn_chord_editor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:minWidth="200dp"
                android:text="和弦编辑器"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:layout_marginBottom="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="12sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="8dp"
                android:gravity="start"/>

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:minWidth="200dp"
                android:text="大模型配置"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
