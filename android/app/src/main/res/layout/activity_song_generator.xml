<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_dark"
    android:paddingTop="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="风格"
            android:textSize="14sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginRight="12dp"/>

        <Spinner
            android:id="@+id/sp_style"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/apple_edittext_bg"
            android:paddingHorizontal="12dp"/>

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="AI生成"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginLeft="12dp"
           />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/apple_card_bg"
        android:padding="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="歌曲信息"
            android:textSize="14sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="标题: 未生成"
            android:textSize="18sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="艺术家: MusicAI"
            android:textSize="16sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="歌曲内容"
            android:textSize="16sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/playback_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="0"
            android:max="100"
            android:progressTint="@color/apple_accent"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_playback_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textSize="12sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:visibility="gone"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="0dp">

        <ListView
            android:id="@+id/lv_song"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/apple_card_bg"
            android:divider="@color/apple_mid_gray"
            android:dividerHeight="1dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="播放歌曲"
            android:textSize="17sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_primary_bg"
           />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
