<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/apple_card_bg"
    android:layout_marginVertical="6dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_drag_handle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_drag_handle"
            android:tint="@color/apple_text_tertiary"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_effect_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_effect_params"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_enable"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="启用"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/apple_button_minor_bg"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:tint="@color/apple_warning"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_params"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/ll_param_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Level"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_level"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="240"
                android:progress="120"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_level_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="0dB"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Frequency"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_frequency"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="50"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_frequency_value"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="1000Hz"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Gain"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_gain"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="240"
                android:progress="120"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_gain_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="0dB"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_q"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Q"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_q"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="10"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_q_value"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Threshold"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_threshold"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="400"
                android:progress="200"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_threshold_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="-20dB"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_ratio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Ratio"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_ratio"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="190"
                android:progress="30"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_ratio_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="4:1"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_attack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Attack"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_attack"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="10"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_attack_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="10ms"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_release"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Release"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_release"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="100"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_release_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="100ms"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_room_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="RoomSize"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_room_size"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_room_size_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_damping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Damping"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_damping"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_damping_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_param_wet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Wet"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

            <SeekBar
                android:id="@+id/seekbar_wet"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="30"
                android:progressTint="@color/apple_accent"
                android:thumbTint="@color/apple_accent"/>

            <TextView
                android:id="@+id/tv_wet_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="30%"
                android:textSize="12sp"
                android:textColor="@color/apple_text_tertiary"
                android:gravity="end"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
