<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="风格"
            android:textSize="14sp"
            android:textColor="@color/apple_text_secondary"
            android:layout_marginRight="12dp"/>

        <Spinner
            android:id="@+id/sp_style"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/apple_edittext_bg"
            android:paddingHorizontal="12dp"/>

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:text="AI生成"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginLeft="12dp"
            android:cornerRadius="10dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="和弦列表"
            android:textSize="16sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <ListView
            android:id="@+id/lv_chords"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/apple_card_bg"
            android:divider="@color/apple_mid_gray"
            android:dividerHeight="1dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_add_chord"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="添加和弦"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:layout_marginRight="8dp"
            android:cornerRadius="10dp"/>

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="删除"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_danger_bg"
            android:cornerRadius="10dp"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

</LinearLayout>