<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_light_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="0dp"
            android:outlineProvider="background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API 配置"
                android:textSize="17sp"
                android:textColor="@color/apple_text"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API 地址"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_api_url"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API Key"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模型名称"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_model_name"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:textSize="15sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="例如：gpt-3.5-turbo"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="0dp"
            android:outlineProvider="background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="生成参数"
                android:textSize="17sp"
                android:textColor="@color/apple_text"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="温度 (Temperature)"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"/>

                <TextView
                    android:id="@+id/tv_temperature_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.7"
                    android:textSize="14sp"
                    android:textColor="@color/apple_accent"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="7"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最大令牌数 (Max Tokens)"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"/>

                <TextView
                    android:id="@+id/tv_max_tokens_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500"
                    android:textSize="14sp"
                    android:textColor="@color/apple_accent"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_max_tokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="50dp"
            android:text="测试连接"
            android:textSize="16sp"
            android:textColor="@color/apple_white"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="50dp"
            android:text="保存设置"
            android:textSize="16sp"
            android:textColor="@color/apple_white"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="重置为默认"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_secondary_bg"/>

        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>
