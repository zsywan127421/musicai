<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础主题配置 -->
    <style name="Theme.MusicAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/apple_accent</item>
        <item name="colorPrimaryDark">@color/apple_accent</item>
        <item name="colorAccent">@color/apple_accent</item>
        <item name="android:textColorPrimary">@color/apple_text</item>
        <item name="android:textColorSecondary">@color/apple_text_secondary</item>
        <item name="android:windowBackground">@color/apple_light_bg</item>
        <item name="android:statusBarColor">@color/apple_light_bg</item>
        <item name="android:navigationBarColor">@color/apple_light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/apple_accent</item>
        <item name="colorPrimaryDark">@color/apple_accent</item>
        <item name="colorAccent">@color/apple_accent</item>
        <item name="android:windowBackground">@color/apple_light_bg</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/apple_light_bg</item>
        <item name="android:textColorPrimary">@color/apple_text</item>
        <item name="android:textColorSecondary">@color/apple_text_secondary</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:background">@color/apple_white</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="AppleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/apple_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppleButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/apple_white</item>
        <item name="android:background">@drawable/apple_button_bg</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AppleButton.Primary">
        <item name="android:background">@drawable/apple_button_primary_bg</item>
    </style>

    <style name="AppleButton.Secondary">
        <item name="android:background">@drawable/apple_button_secondary_bg</item>
    </style>

    <style name="AppleButton.Danger">
        <item name="android:background">@drawable/apple_button_danger_bg</item>
    </style>

    <style name="AppleButton.Minor">
        <item name="android:background">@drawable/apple_button_minor_bg</item>
    </style>

    <style name="AppleEditText">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/apple_text</item>
        <item name="android:textColorHint">@color/apple_text_tertiary</item>
        <item name="android:background">@drawable/apple_edittext_bg</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="AppleCard">
        <item name="android:background">@drawable/apple_card_bg</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="AppleText.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/apple_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppleText.Headline">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/apple_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppleText.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/apple_text</item>
    </style>

    <style name="AppleText.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/apple_text_secondary</item>
    </style>

    <style name="AppleText.Section">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/apple_text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
