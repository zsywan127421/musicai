<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="大模型配置"
                android:textSize="24sp"
                android:textColor="@color/apple_text"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="配置自定义大模型，使用 OpenAI API 格式"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API 地址"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_api_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:hint="https://api.deepseek.com/v1"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API 密钥"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:hint="sk-..."
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:inputType="textPassword"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模型名称"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:hint="deepseek-v4-flash"
                android:textSize="14sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="温度"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"/>

                <TextView
                    android:id="@+id/tv_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.70"
                    android:textSize="14sp"
                    android:textColor="@color/apple_accent"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70"
                android:thumbTint="@color/apple_accent"
                android:progressBackgroundTint="@color/apple_mid_gray"
                android:progressTint="@color/apple_accent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="控制生成的随机性"
                android:textSize="11sp"
                android:textColor="@color/apple_light_gray"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/apple_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最大 Token"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"/>

                <TextView
                    android:id="@+id/tv_max_tokens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500"
                    android:textSize="14sp"
                    android:textColor="@color/apple_accent"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_max_tokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1900"
                android:progress="400"
                android:thumbTint="@color/apple_accent"
                android:progressBackgroundTint="@color/apple_mid_gray"
                android:progressTint="@color/apple_accent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="控制生成内容的最大长度"
                android:textSize="11sp"
                android:textColor="@color/apple_light_gray"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:minHeight="46dp"
            android:minWidth="180dp"
            android:layout_gravity="center_horizontal"
            android:text="测试连接"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:visibility="gone"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="保存设置"
            android:textSize="15sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_primary_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="重置为默认值"
            android:textSize="14sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>
</ScrollView>
