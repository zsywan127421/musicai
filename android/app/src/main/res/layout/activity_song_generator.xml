<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_light_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/apple_card_bg"
        android:layout_margin="16dp"
        android:elevation="0dp"
        android:outlineProvider="background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="快速歌曲生成"
            android:textSize="20sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="风格"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/sp_style"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="旋律"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/sp_melody"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="和弦"
                android:textSize="14sp"
                android:textColor="@color/apple_text_secondary"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/sp_chords"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/apple_edittext_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <ListView
                android:id="@+id/lv_result"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/apple_card_bg"
                android:divider="@color/apple_separator"
                android:dividerHeight="1dp"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/apple_light_bg">

        <com.example.musicai.CursorSeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_playback_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textSize="13sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/speed_control_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="速度: 1x"
                android:textSize="13sp"
                android:textColor="@color/apple_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button android:id="@+id/btn_speed_05" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="0.5x" android:textSize="12sp" android:textColor="@color/apple_text" android:background="@drawable/apple_button_bg" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btn_speed_075" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="0.75x" android:textSize="12sp" android:textColor="@color/apple_text" android:background="@drawable/apple_button_bg" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btn_speed_1" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="1x" android:textSize="12sp" android:textColor="@color/apple_white" android:background="@drawable/apple_button_primary_bg" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btn_speed_125" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="1.25x" android:textSize="12sp" android:textColor="@color/apple_text" android:background="@drawable/apple_button_bg" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btn_speed_15" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="1.5x" android:textSize="12sp" android:textColor="@color/apple_text" android:background="@drawable/apple_button_bg" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btn_speed_2" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="2x" android:textSize="12sp" android:textColor="@color/apple_text" android:background="@drawable/apple_button_bg"/>

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="50dp"
            android:text="一键生成完整曲子"
            android:textSize="16sp"
            android:textColor="@color/apple_white"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:text="播放"
                android:textSize="16sp"
                android:textColor="@color/apple_white"
                android:background="@drawable/apple_button_primary_bg"
                android:enabled="false"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="16sp"
                android:textColor="@color/apple_text"
                android:background="@drawable/apple_button_bg"
                android:enabled="false"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

</LinearLayout>
