<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵 MusicAI"
        android:textSize="32sp"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_model_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="大模型: 未配置"
        android:textSize="16sp"
        android:textColor="#ff0000"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_melody_editor"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🎹 旋律编辑器"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:background="#4a4a6a"
        android:layout_marginBottom="12dp"
       />

    <Button
        android:id="@+id/btn_chord_editor"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🎸 和弦走向"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:background="#4a4a6a"
        android:layout_marginBottom="12dp"
       />

    <Button
        android:id="@+id/btn_song_generator"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🎵 曲子生成"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:background="#4a4a6a"
        android:layout_marginBottom="12dp"
       />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⚙️ 大模型配置"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:background="#4a4a6a"
       />

</LinearLayout>
