<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_light_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择和弦"
            android:textSize="20sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:text="返回"
            android:textSize="14sp"
            android:textColor="@color/apple_button_text"
            android:background="@drawable/apple_button_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/select_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="和弦库为空\n请先在高级生成器中创建和弦"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text_secondary"
                    android:visibility="gone"
                    android:padding="40dp"/>

                <ListView
                    android:id="@+id/lv_library"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="8dp"
                    android:padding="6dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/edit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_entry_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:hint="输入和弦名称"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text"
                    android:textColorHint="@color/apple_text_secondary"
                    android:background="@drawable/apple_edittext_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="根音"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/sp_chord_root"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="0.8"
                        android:background="@drawable/apple_edittext_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="类型"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/sp_chord_type"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/apple_edittext_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时值"
                        android:textSize="13sp"
                        android:textColor="@color/apple_text_secondary"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/sp_chord_duration"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="0.6"
                        android:background="@drawable/apple_edittext_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_add_custom_chord"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:minHeight="42dp"
                    android:text="添加和弦"
                    android:textSize="14sp"
                    android:textColor="@color/apple_button_text"
                    android:background="@drawable/apple_button_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="和弦列表"
                    android:textSize="14sp"
                    android:textColor="@color/apple_text"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <ListView
                    android:id="@+id/lv_chords"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/apple_card_bg"
                    android:divider="@color/apple_mid_gray"
                    android:dividerHeight="1dp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_shift_left"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:layout_weight="1"
                        android:text="降半音"
                        android:textSize="13sp"
                        android:textColor="@color/apple_button_text"
                        android:background="@drawable/apple_button_bg"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btn_delete"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:layout_weight="1"
                        android:text="删除"
                        android:textSize="13sp"
                        android:textColor="@color/apple_white"
                        android:background="@drawable/apple_button_danger_bg"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btn_add_chord"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:layout_weight="1"
                        android:text="随机"
                        android:textSize="13sp"
                        android:textColor="@color/apple_button_text"
                        android:background="@drawable/apple_button_bg"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btn_shift_right"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:layout_weight="1"
                        android:text="升半音"
                        android:textSize="13sp"
                        android:textColor="@color/apple_button_text"
                        android:background="@drawable/apple_button_bg"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:layout_weight="1"
                        android:text="保存"
                        android:textSize="14sp"
                        android:textColor="@color/apple_button_text"
                        android:background="@drawable/apple_button_bg"
                        android:layout_marginEnd="6dp"/>

                    <Button
                        android:id="@+id/btn_save_as"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:minHeight="44dp"
                        android:layout_weight="1"
                        android:text="另存为"
                        android:textSize="14sp"
                        android:textColor="@color/apple_button_text"
                        android:background="@drawable/apple_button_bg"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
