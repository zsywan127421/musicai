<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/apple_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MusicAI"
            android:textSize="34sp"
            android:textColor="@color/apple_text"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI 音乐创作助手"
            android:textSize="16sp"
            android:textColor="@color/apple_text_secondary"
            android:gravity="center"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/model_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/apple_card_bg"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/apple_success"/>

        <TextView
            android:id="@+id/tv_model_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="大模型已配置"
            android:textSize="16sp"
            android:textColor="@color/apple_text"/>

        <TextView
            android:id="@+id/tv_model_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="gpt-3.5-turbo"
            android:textSize="14sp"
            android:textColor="@color/apple_text_secondary"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btn_melody_editor"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🎹 旋律编辑器"
            android:textSize="18sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_primary_bg"
            android:layout_marginBottom="16dp"
            android:cornerRadius="12dp"/>

        <Button
            android:id="@+id/btn_chord_editor"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🎸 和弦走向"
            android:textSize="18sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:layout_marginBottom="16dp"
            android:cornerRadius="12dp"/>

        <Button
            android:id="@+id/btn_song_generator"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🎵 曲子生成"
            android:textSize="18sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:layout_marginBottom="16dp"
            android:cornerRadius="12dp"/>

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="⚙️ 大模型配置"
            android:textSize="18sp"
            android:textColor="@color/apple_text"
            android:background="@drawable/apple_button_bg"
            android:cornerRadius="12dp"/>

    </LinearLayout>

</LinearLayout>