<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/apple_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tv_track_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="主旋律"
        android:textSize="15sp"
        android:textColor="@color/apple_text"/>

    <Button
        android:id="@+id/btn_mute"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="静音"
        android:textSize="12sp"
        android:textColor="@color/apple_white"
        android:background="@drawable/apple_button_bg"
        android:paddingHorizontal="8dp"
        android:layout_marginEnd="4dp"/>

    <Button
        android:id="@+id/btn_solo"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="独奏"
        android:textSize="12sp"
        android:textColor="@color/apple_white"
        android:background="@drawable/apple_button_bg"
        android:paddingHorizontal="8dp"
        android:layout_marginEnd="4dp"/>

    <Button
        android:id="@+id/btn_instrument"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="Piano"
        android:textSize="12sp"
        android:textColor="@color/apple_text"
        android:background="@drawable/apple_button_bg"
        android:paddingHorizontal="8dp"/>

</LinearLayout>
