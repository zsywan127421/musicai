<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="编辑音符"
        android:textSize="18sp"
        android:textColor="@color/apple_text"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="音符编号"
        android:textSize="13sp"
        android:textColor="@color/apple_text_secondary"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_note_index"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="16sp"
        android:textColor="@color/apple_text"
        android:background="@drawable/apple_edittext_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="音高"
        android:textSize="13sp"
        android:textColor="@color/apple_text_secondary"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/sp_pitch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        android:background="@drawable/spinner_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="八度"
        android:textSize="13sp"
        android:textColor="@color/apple_text_secondary"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/sp_octave"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        android:background="@drawable/spinner_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="时值"
        android:textSize="13sp"
        android:textColor="@color/apple_text_secondary"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/sp_duration"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        android:background="@drawable/spinner_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"/>

</LinearLayout>
