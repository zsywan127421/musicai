<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="生成功能测试"
        android:textSize="24sp"
        android:textColor="@color/apple_black"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="API测试"
            android:background="@drawable/apple_button_secondary_bg"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_test_melody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="旋律"
            android:background="@drawable/apple_button_secondary_bg"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_test_chords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="和弦"
            android:background="@drawable/apple_button_secondary_bg"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_test_full_song"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="曲子"
            android:background="@drawable/apple_button_secondary_bg"
            android:textAllCaps="false"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_test_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="运行全部测试"
        android:background="@drawable/apple_button_primary_bg"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="测试日志:"
        android:textSize="14sp"
        android:textColor="@color/apple_text_secondary"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/apple_card_bg"
        android:padding="12dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/apple_black"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"/>

    </ScrollView>

</LinearLayout>
